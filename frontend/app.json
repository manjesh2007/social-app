{
  "expo": {
    "name": "Nearby Friends",
    "slug": "nearby-friends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nearbyfriends",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.liveconnectstaging.dcswuz",
      "infoPlist": {
        "NSCameraUsageDescription": "Enable camera to join Live Connect video matching",
        "NSMicrophoneUsageDescription": "Enable microphone to talk with friends on Live Connect",
        "NSLocationWhenInUseUsageDescription": "Find nearby friends and community members around you"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFDF9"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.liveconnectstaging.dcswuz",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDF9"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Enable camera to join Live Connect video matching",
          "microphonePermission": "Enable microphone to talk with friends on Live Connect"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
